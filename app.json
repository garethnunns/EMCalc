{
  "expo": {
    "name": "EM Calc",
    "slug": "EMCalc",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.garethnunns.emcalc"
    },
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon-squircle.png"
    },
    "android": {
      "package": "com.garethnunns.emcalc"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 200
        }
      ]
    ]
  }
}
