{
  "name": "emcalc",
  "description": "Barco Event Master Custom Format Calculator",
  "version": "1.3.0",
  "homepage": "https://e2.garethnunns.com",
  "license": "Copyright Gareth Nunns 2020",
  "author": "Gareth Nunns <gareth@garethnunns.com>",
  "repository": "https://github.com/garethnunns/EMCalc",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "desktop": "npm run build-web && electron electron/main.js",
    "test": "mocha",
    "build-web": "expo export --platform web --output-dir web-build && node scripts/write-version.mjs",
    "build-desktop": "npm run build-web && electron-builder --publish never"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "color": "^5.0.3",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-font": "~58.0.12",
    "expo-splash-screen": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-paper": "^5.15.5",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "mocha": "^12.0.3"
  },
  "private": true,
  "build": {
    "appId": "com.garethnunns.emcalc",
    "productName": "EM Calc",
    "copyright": "© 2020 Generative Noise",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "electron/**/*",
      "web-build/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": "zip",
      "category": "public.app-category.utilities",
      "icon": "assets/icon-mac.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon-squircle.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon-squircle.png"
    },
    "nsis": {
      "deleteAppDataOnUninstall": true
    },
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
